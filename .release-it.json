{
  "npm": {
    "publish": false
  },
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}"
  },
  "hooks": {
    "before:init": [
      "bun --bun run lint",
      "bun --bun run typecheck",
      "bun --bun run test -- --run"
    ],
    "after:bump": [
      "bun --bun run build",
      "bun --bun run build-firefox",
      "bun --bun run pack:zip",
      "bun --bun run pack:zip-firefox",
      "bun --bun run pack:zip-firefox-sources"
    ],
    "after:release": [
      "gh release upload v${version} extension.zip extension-firefox.zip",
      "bun --bun run submit"
    ]
  }
}
